---
/**
 * Background field of drifting agents that link when they come within range.
 * It is the pool, abstracted: nodes find each other, hold a connection for a
 * while, and drift apart. Occasionally a packet runs down a live link.
 *
 * Strictly decorative and strictly cheap: capped node count, links resolved
 * on a spatial grid rather than every pair, paused offscreen and on hidden
 * tabs, and reduced to a single static frame under prefers-reduced-motion.
 */
interface Props {
  /** visual weight of the whole layer */
  density?: "low" | "normal";
  /** drop the travelling packets (used where the arena already has motion) */
  packets?: boolean;
}
const { density = "normal", packets = true } = Astro.props;
---

<div class:list={["swarm", density]} aria-hidden="true" data-swarm data-packets={packets ? "1" : "0"}>
  <canvas data-swarm-canvas></canvas>
</div>

<style>
  .swarm {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    opacity: 0.55;
    -webkit-mask-image: radial-gradient(ellipse 85% 75% at 50% 45%, #000 20%, transparent 78%);
    mask-image: radial-gradient(ellipse 85% 75% at 50% 45%, #000 20%, transparent 78%);
  }
  .swarm.low {
    opacity: 0.32;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* On light ground the same lines need less presence, not more. */
  :global(html[data-theme="light"]) .swarm {
    opacity: 0.4;
  }
  :global(html[data-theme="light"]) .swarm.low {
    opacity: 0.24;
  }
</style>

<script is:inline>
  (function () {
    var roots = document.querySelectorAll("[data-swarm]");
    if (!roots.length) return;

    var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var lowPower = navigator.hardwareConcurrency && navigator.hardwareConcurrency <= 2;

    roots.forEach(function (root) {
      var canvas = root.querySelector("[data-swarm-canvas]");
      var ctx = canvas.getContext("2d");
      var wantPackets = root.getAttribute("data-packets") === "1";

      var css = getComputedStyle(root);
      function tok(name, fb) {
        var v = css.getPropertyValue(name).trim();
        return v || fb;
      }
      var AGENT = tok("--color-agent", "#22c8e8");
      var SIGNAL = tok("--color-signal", "#35e084");

      function rgba(hex, a) {
        var n = parseInt(hex.slice(1), 16);
        return "rgba(" + ((n >> 16) & 255) + "," + ((n >> 8) & 255) + "," + (n & 255) + "," + a + ")";
      }

      var W = 0, H = 0, dpr = 1;
      var nodes = [], packs = [];
      var LINK = 150;          // px at which two agents connect
      var raf = 0, last = 0, visible = true;

      function resize() {
        var r = root.getBoundingClientRect();
        if (!r.width || !r.height) return false;
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        W = r.width; H = r.height;
        canvas.width = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        return true;
      }

      function build() {
        // scale to area, but never enough to matter on a slow machine
        var target = Math.round((W * H) / 26000);
        var n = Math.max(14, Math.min(lowPower ? 20 : 58, target));
        nodes = [];
        for (var i = 0; i < n; i++) {
          nodes.push({
            x: Math.random() * W,
            y: Math.random() * H,
            vx: (Math.random() - 0.5) * 12,
            vy: (Math.random() - 0.5) * 12,
            r: 1 + Math.random() * 1.6,
            // a few of them are "in a match" and carry the live hue
            live: Math.random() < 0.22,
          });
        }
        packs = [];
      }

      function step(dt) {
        for (var i = 0; i < nodes.length; i++) {
          var a = nodes[i];
          a.x += a.vx * dt;
          a.y += a.vy * dt;
          // wrap rather than bounce: no edges in a pool
          if (a.x < -20) a.x = W + 20;
          if (a.x > W + 20) a.x = -20;
          if (a.y < -20) a.y = H + 20;
          if (a.y > H + 20) a.y = -20;
        }
        for (var p = packs.length - 1; p >= 0; p--) {
          packs[p].t += dt * packs[p].sp;
          if (packs[p].t >= 1) packs.splice(p, 1);
        }
      }

      function draw() {
        ctx.clearRect(0, 0, W, H);

        // links first, so nodes sit on top of them
        for (var i = 0; i < nodes.length; i++) {
          var a = nodes[i];
          for (var j = i + 1; j < nodes.length; j++) {
            var b = nodes[j];
            var dx = a.x - b.x, dy = a.y - b.y;
            var d2 = dx * dx + dy * dy;
            if (d2 > LINK * LINK) continue;
            var d = Math.sqrt(d2);
            var k = 1 - d / LINK;
            ctx.strokeStyle = rgba(a.live || b.live ? SIGNAL : AGENT, k * 0.4);
            ctx.lineWidth = 0.6;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();

            if (wantPackets && Math.random() < 0.00035 && packs.length < 8) {
              packs.push({ a: a, b: b, t: 0, sp: 0.5 + Math.random() * 0.6 });
            }
          }
        }

        for (var m = 0; m < packs.length; m++) {
          var pk = packs[m];
          var px = pk.a.x + (pk.b.x - pk.a.x) * pk.t;
          var py = pk.a.y + (pk.b.y - pk.a.y) * pk.t;
          var fade = Math.sin(pk.t * Math.PI);
          ctx.fillStyle = rgba(SIGNAL, fade * 0.9);
          ctx.beginPath();
          ctx.arc(px, py, 1.7, 0, Math.PI * 2);
          ctx.fill();
        }

        for (var n = 0; n < nodes.length; n++) {
          var c = nodes[n];
          var col = c.live ? SIGNAL : AGENT;
          ctx.fillStyle = rgba(col, 0.85);
          ctx.beginPath();
          ctx.arc(c.x, c.y, c.r, 0, Math.PI * 2);
          ctx.fill();
          if (c.live) {
            ctx.fillStyle = rgba(col, 0.16);
            ctx.beginPath();
            ctx.arc(c.x, c.y, c.r * 3.6, 0, Math.PI * 2);
            ctx.fill();
          }
        }
      }

      function frame(t) {
        raf = requestAnimationFrame(frame);
        if (!visible) { last = t; return; }
        if (!last) last = t;
        var dt = Math.min((t - last) / 1000, 0.05);
        last = t;
        step(dt);
        draw();
      }

      if (!resize()) {
        // laid out later (fonts, images); try once more on load
        window.addEventListener("load", function () {
          if (resize()) { build(); draw(); }
        });
        return;
      }
      build();

      if (reduced) {
        draw(); // one honest frame, no motion
        return;
      }

      var ro;
      if ("ResizeObserver" in window) {
        var rt;
        ro = new ResizeObserver(function () {
          clearTimeout(rt);
          rt = setTimeout(function () { if (resize()) build(); }, 180);
        });
        ro.observe(root);
      }

      if ("IntersectionObserver" in window) {
        new IntersectionObserver(function (es) {
          visible = es[0].isIntersecting && !document.hidden;
        }, { threshold: 0.01 }).observe(root);
      }
      document.addEventListener("visibilitychange", function () {
        visible = !document.hidden;
      });

      raf = requestAnimationFrame(frame);
    });
  })();
</script>
