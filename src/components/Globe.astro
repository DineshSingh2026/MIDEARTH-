---
import { LAND, REGIONS } from "../data/world";

/**
 * Ambient background: a slowly rotating globe with real cloud regions on it
 * and great-circle arcs running between them.
 *
 * It maps onto the product rather than decorating it:
 *   dotted land = the world, from the same LAND mask the network map uses
 *   marker      = a data centre, at its real coordinates
 *   arc         = a connection between two regions
 *   pulse       = an agent crossing it to reach a match
 *   flash       = the match settled at the far end
 *
 * Orthographic projection with back-hemisphere culling: a point is only drawn
 * when it faces the viewer, and fades as it approaches the limb, which is what
 * makes a flat dot field read as a sphere. Arcs are slerped between endpoints
 * and lifted off the surface, so they curve over the horizon like flight paths
 * instead of cutting through the planet.
 */
interface Props {
  /** visual weight of the whole layer */
  density?: "low" | "normal";
  /** drop the travelling pulses where a section already carries motion */
  packets?: boolean;
  /** horizontal centre as a fraction of the container, for composition */
  x?: number;
  /** radius as a fraction of the smaller container dimension */
  scale?: number;
}
const { density = "normal", packets = true, x = 0.5, scale = 0.46 } = Astro.props;
---

<div
  class:list={["globe", density]}
  aria-hidden="true"
  data-globe
  data-packets={packets ? "1" : "0"}
  data-x={x}
  data-scale={scale}
>
  <canvas data-globe-canvas></canvas>
</div>

<style>
  .globe {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    opacity: 0.95;
  }
  .globe.low {
    opacity: 0.55;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  :global(html[data-theme="light"]) .globe {
    opacity: 0.6;
  }
  :global(html[data-theme="light"]) .globe.low {
    opacity: 0.35;
  }
</style>

<script is:inline define:vars={{ LAND, REGIONS }}>
  (function () {
    var roots = document.querySelectorAll("[data-globe]");
    if (!roots.length) return;

    var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var lowPower = navigator.hardwareConcurrency && navigator.hardwareConcurrency <= 2;
    var RAD = Math.PI / 180;

    roots.forEach(function (root) {
      var canvas = root.querySelector("[data-globe-canvas]");
      var ctx = canvas.getContext("2d");
      var wantPulses = root.getAttribute("data-packets") === "1";
      var xFrac = parseFloat(root.getAttribute("data-x")) || 0.5;
      var scaleFrac = parseFloat(root.getAttribute("data-scale")) || 0.46;

      var css = getComputedStyle(root);
      function tok(n, fb) {
        var v = css.getPropertyValue(n).trim();
        return v || fb;
      }
      var AGENT = tok("--color-agent", "#22c8e8");
      var AGENT_HOT = tok("--color-agent-hot", "#7de9f7");
      var SIGNAL = tok("--color-signal", "#35e084");

      function rgba(hex, a) {
        var n = parseInt(hex.slice(1), 16);
        return "rgba(" + ((n >> 16) & 255) + "," + ((n >> 8) & 255) + "," + (n & 255) + "," + a + ")";
      }

      /* ------------------------------------------------ sphere maths ---- */
      function toVec(lat, lon) {
        var la = lat * RAD, lo = lon * RAD, cl = Math.cos(la);
        return [cl * Math.sin(lo), Math.sin(la), cl * Math.cos(lo)];
      }
      function toLatLon(v) {
        return {
          lat: Math.asin(Math.max(-1, Math.min(1, v[1]))) / RAD,
          lon: Math.atan2(v[0], v[2]) / RAD,
        };
      }
      // great-circle interpolation, so an arc follows the surface
      function slerp(a, b, t) {
        var dot = Math.max(-1, Math.min(1, a[0] * b[0] + a[1] * b[1] + a[2] * b[2]));
        var om = Math.acos(dot);
        if (om < 1e-6) return a.slice();
        var s = Math.sin(om);
        var k1 = Math.sin((1 - t) * om) / s, k2 = Math.sin(t * om) / s;
        return [a[0] * k1 + b[0] * k2, a[1] * k1 + b[1] * k2, a[2] * k1 + b[2] * k2];
      }

      var W = 0, H = 0, dpr = 1, cx = 0, cy = 0, R = 0;
      var spin = 0, land = [], sites = [], arcs = [], pulses = [];
      var raf = 0, last = 0, visible = true, spawnIn = 0.5;

      function project(lat, lon, lift) {
        var la = lat * RAD, lo = (lon + spin) * RAD, cl = Math.cos(la);
        var r = R * (lift || 1);
        return {
          x: cx + cl * Math.sin(lo) * r,
          y: cy - Math.sin(la) * r,
          z: cl * Math.cos(lo), // > 0 means facing us
        };
      }

      function build() {
        land = [];
        for (var i = 0; i < LAND.length; i++) {
          var row = LAND[i];
          var lat = 90 - row.r * 5 - 2.5;
          for (var s = 0; s < row.s.length; s++) {
            for (var c = row.s[s][0]; c <= row.s[s][1]; c++) {
              land.push({ lat: lat, lon: -180 + c * 5 + 2.5 });
            }
          }
        }

        sites = REGIONS.map(function (rg) {
          return { lat: rg.lat, lon: rg.lon, flash: 0, pulse: Math.random() * 6.28 };
        });

        // arcs between region pairs, slerped and lifted off the surface
        arcs = [];
        var pairs = lowPower ? 6 : 13;
        for (var p = 0; p < pairs; p++) {
          var a = Math.floor(Math.random() * sites.length);
          var b = Math.floor(Math.random() * sites.length);
          if (a === b) b = (b + 1) % sites.length;
          var va = toVec(sites[a].lat, sites[a].lon);
          var vb = toVec(sites[b].lat, sites[b].lon);
          var pts = [];
          var STEPS = 26;
          for (var k = 0; k <= STEPS; k++) {
            var t = k / STEPS;
            var ll = toLatLon(slerp(va, vb, t));
            pts.push({ lat: ll.lat, lon: ll.lon, lift: 1 + 0.17 * Math.sin(Math.PI * t) });
          }
          arcs.push({ pts: pts, to: b });
        }
      }

      function layout() {
        var r = root.getBoundingClientRect();
        if (!r.width || !r.height) return false;
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        W = r.width;
        H = r.height;
        canvas.width = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        cx = W * xFrac;
        cy = H * 0.5;
        R = Math.min(W, H) * scaleFrac;
        return true;
      }

      function spawn() {
        if (!arcs.length) return;
        var a = arcs[Math.floor(Math.random() * arcs.length)];
        pulses.push({ arc: a, t: 0, sp: 0.16 + Math.random() * 0.16 });
      }

      function step(dt) {
        spin += dt * 2.6; // ~2.3 minutes a revolution
        if (spin > 360) spin -= 360;

        if (wantPulses) {
          spawnIn -= dt;
          if (spawnIn <= 0 && pulses.length < (lowPower ? 3 : 9)) {
            spawn();
            spawnIn = 0.4 + Math.random() * 0.7;
          }
        }
        for (var i = pulses.length - 1; i >= 0; i--) {
          var pu = pulses[i];
          pu.t += pu.sp * dt;
          if (pu.t >= 1) {
            sites[pu.arc.to].flash = 1; // it settled at the far end
            pulses.splice(i, 1);
          }
        }
        for (var s = 0; s < sites.length; s++) {
          if (sites[s].flash > 0) sites[s].flash = Math.max(0, sites[s].flash - dt * 1.4);
        }
      }

      function draw(time) {
        ctx.clearRect(0, 0, W, H);

        // the body of the sphere, so the dots sit on something
        var g = ctx.createRadialGradient(cx - R * 0.3, cy - R * 0.35, R * 0.1, cx, cy, R);
        g.addColorStop(0, rgba(AGENT, 0.16));
        g.addColorStop(0.65, rgba(AGENT, 0.05));
        g.addColorStop(1, "rgba(0,0,0,0)");
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(cx, cy, R, 0, Math.PI * 2);
        ctx.fill();

        // limb
        ctx.strokeStyle = rgba(AGENT, 0.34);
        ctx.lineWidth = 1.1;
        ctx.beginPath();
        ctx.arc(cx, cy, R, 0, Math.PI * 2);
        ctx.stroke();

        // graticule: a few meridians and parallels, which is what stops a dot
        // field from reading as a flat scatter
        ctx.lineWidth = 0.7;
        for (var mo = -180; mo < 180; mo += 30) {
          ctx.beginPath();
          var penm = false;
          for (var mlat = -80; mlat <= 80; mlat += 5) {
            var mp = project(mlat, mo, 1);
            if (mp.z <= 0.02) { penm = false; continue; }
            if (!penm) { ctx.moveTo(mp.x, mp.y); penm = true; } else ctx.lineTo(mp.x, mp.y);
          }
          ctx.strokeStyle = rgba(AGENT, 0.13);
          ctx.stroke();
        }
        for (var pa = -60; pa <= 60; pa += 30) {
          ctx.beginPath();
          var penp = false;
          for (var plon = -180; plon <= 180; plon += 5) {
            var pp2 = project(pa, plon, 1);
            if (pp2.z <= 0.02) { penp = false; continue; }
            if (!penp) { ctx.moveTo(pp2.x, pp2.y); penp = true; } else ctx.lineTo(pp2.x, pp2.y);
          }
          ctx.strokeStyle = rgba(AGENT, 0.13);
          ctx.stroke();
        }

        // land — culled to the near hemisphere, fading toward the limb
        for (var i = 0; i < land.length; i++) {
          var p = project(land[i].lat, land[i].lon, 1);
          if (p.z <= 0.02) continue;
          var a = Math.min(1, p.z * 1.6);
          ctx.fillStyle = rgba(AGENT, 0.62 * a);
          ctx.beginPath();
          ctx.arc(p.x, p.y, 1.75 * a + 0.4, 0, Math.PI * 2);
          ctx.fill();
        }

        // arcs
        for (var k = 0; k < arcs.length; k++) {
          var pts = arcs[k].pts;
          ctx.beginPath();
          var pen = false;
          for (var q = 0; q < pts.length; q++) {
            var pp = project(pts[q].lat, pts[q].lon, pts[q].lift);
            if (pp.z <= -0.15) { pen = false; continue; }
            if (!pen) { ctx.moveTo(pp.x, pp.y); pen = true; }
            else ctx.lineTo(pp.x, pp.y);
          }
          ctx.strokeStyle = rgba(AGENT, 0.34);
          ctx.lineWidth = 1.1;
          ctx.stroke();
        }

        // pulses riding the arcs
        for (var m = 0; m < pulses.length; m++) {
          var pu = pulses[m];
          var pts2 = pu.arc.pts;
          var idx = pu.t * (pts2.length - 1);
          var from = Math.max(0, Math.floor(idx) - 5);
          ctx.beginPath();
          var pen2 = false;
          for (var n = from; n <= idx; n++) {
            var d = pts2[Math.min(pts2.length - 1, Math.floor(n))];
            var dp = project(d.lat, d.lon, d.lift);
            if (dp.z <= -0.1) { pen2 = false; continue; }
            if (!pen2) { ctx.moveTo(dp.x, dp.y); pen2 = true; }
            else ctx.lineTo(dp.x, dp.y);
          }
          ctx.strokeStyle = rgba(AGENT_HOT, 0.8);
          ctx.lineWidth = 1.7;
          ctx.stroke();

          var hd = pts2[Math.min(pts2.length - 1, Math.round(idx))];
          var hp = project(hd.lat, hd.lon, hd.lift);
          if (hp.z > -0.1) {
            ctx.save();
            ctx.shadowColor = SIGNAL;
            ctx.shadowBlur = 12;
            ctx.fillStyle = SIGNAL;
            ctx.beginPath();
            ctx.arc(hp.x, hp.y, 2.4, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
          }
        }

        // data centres
        for (var s = 0; s < sites.length; s++) {
          var st = sites[s];
          var sp = project(st.lat, st.lon, 1.01);
          if (sp.z <= 0.03) continue;
          var vis = Math.min(1, sp.z * 1.8);
          var live = st.flash > 0;
          var col = live ? SIGNAL : AGENT;

          if (live) {
            ctx.strokeStyle = rgba(SIGNAL, st.flash * 0.6);
            ctx.lineWidth = 1.2;
            ctx.beginPath();
            ctx.arc(sp.x, sp.y, 4 + (1 - st.flash) * 22, 0, Math.PI * 2);
            ctx.stroke();
          } else {
            // idle breathing, so a region is alive between connections
            var bl = 0.5 + 0.5 * Math.sin(time / 700 + st.pulse);
            ctx.fillStyle = rgba(AGENT, 0.1 * vis + bl * 0.12 * vis);
            ctx.beginPath();
            ctx.arc(sp.x, sp.y, 7, 0, Math.PI * 2);
            ctx.fill();
          }

          ctx.save();
          ctx.shadowColor = col;
          ctx.shadowBlur = live ? 14 : 8;
          ctx.fillStyle = rgba(col, (live ? 1 : 0.9) * vis);
          ctx.fillRect(sp.x - 2.6, sp.y - 2.6, 5.2, 5.2);
          ctx.restore();
        }
      }

      if (!layout()) {
        window.addEventListener("load", function () {
          if (layout()) { build(); draw(0); }
        });
        return;
      }
      build();

      if (reduced) {
        // one honest frame, with a few connections mid-flight
        for (var i = 0; i < Math.min(3, arcs.length); i++) {
          pulses.push({ arc: arcs[i], t: 0.35 + i * 0.15, sp: 0 });
        }
        draw(0);
        window.addEventListener("resize", function () {
          if (layout()) draw(0);
        }, { passive: true });
        return;
      }

      var rt;
      if ("ResizeObserver" in window) {
        new ResizeObserver(function () {
          clearTimeout(rt);
          rt = setTimeout(function () { layout(); }, 200);
        }).observe(root);
      }
      if ("IntersectionObserver" in window) {
        new IntersectionObserver(function (es) {
          visible = es[0].isIntersecting && !document.hidden;
        }, { threshold: 0.01 }).observe(root);
      }
      document.addEventListener("visibilitychange", function () {
        visible = !document.hidden;
      });

      function frame(t) {
        raf = requestAnimationFrame(frame);
        if (!visible) { last = t; return; }
        if (!last) last = t;
        var dt = Math.min((t - last) / 1000, 0.05);
        last = t;
        step(dt);
        draw(t);
      }
      raf = requestAnimationFrame(frame);
    });
  })();
</script>
